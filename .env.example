# Orbit AI Backend Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ── AI Provider ────────────────────────────────────────────
# Choose: openai | gemini
AI_PROVIDER=openai

# OpenAI: get key at https://platform.openai.com/api-keys
# Supported models: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_API_KEY=your-openai-key-here
AI_MODEL=gpt-4o

# Google Gemini: get key at https://aistudio.google.com/app/apikey
# Supported models: gemini-1.5-pro, gemini-1.5-flash
GOOGLE_API_KEY=your-google-key-here

# ── Project ────────────────────────────────────────────────
# Absolute path to the Orbit project folder (contains index.html)
PROJECT_ROOT=C:\New folder\Fit_Tracker\Fit_Tracker

# ── Desktop Control ────────────────────────────────────────
# Set to true ONLY if you want Orbit to control your desktop
# DESKTOP_CONTROL_ENABLED=false

# ── Security ───────────────────────────────────────────────
# Auto-generated on each server start. Override to fix across restarts.
# SESSION_TOKEN=your-secure-random-token-here

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
